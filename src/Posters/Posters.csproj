<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>tech.rethunk.mortar.Posters</AssemblyName>
    <AssemblyTitle>Posters</AssemblyTitle>
    <RootNamespace>Posters</RootNamespace>
    <RepositoryUrl>https://github.com/Rethunk-Tech/mortar-lc-posters</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <IsThunderstorePackable>true</IsThunderstorePackable>
    <ThunderstoreName>Posters</ThunderstoreName>
    <ThunderstoreDescription>Your own pictures on the ship's posters, tips board and paintings. Reads LethalPosters and LethalPaintings packs.</ThunderstoreDescription>
    <ThunderstoreCommunities>lethal-company</ThunderstoreCommunities>
    <ThunderstoreCategories>libraries;poster;clientside;bepinex</ThunderstoreCategories>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />
    <ThunderstoreDependency Include="BepInEx-BepInExPack" Version="5.4.2305" />
    <ThunderstoreDependency Include="Mortar-ConfigSync" Version="0.1.0" />
    <Reference Include="$(MortarDependency_Mortar_ConfigSync)**/*.dll" Condition="'$(MortarDependency_Mortar_ConfigSync)' != ''" Private="false" />
  </ItemGroup>
</Project>
